{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AYDY",
  "version": "0.1.0",
  "identifier": "app.aydy",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "AYDY",
        "url": "index.html",
        "width": 320,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true
      }
    ],
    "trayIcon": {
      "id": "aydy",
      "iconPath": "icons/tray/quiet.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "category": "DeveloperTool",
    "shortDescription": "Every active Claude Code session at a glance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
