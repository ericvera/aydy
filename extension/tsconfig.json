{
  "$schema": "https://json.schemastore.org/tsconfig",

  "extends": ["@tsconfig/strictest/tsconfig.json"],

  "compilerOptions": {
    /* Language and Environment — the VS Code extension host is Node, with no
       DOM and no bundler. */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* Modules — the extension host loads extensions with `require`. */
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node", "vscode"],

    /* Emit — nothing bundles this, so TypeScript is what produces the
       extension's `main`. */
    "outDir": "out",
    "rootDir": "src",

    "skipLibCheck": true
  },

  "include": ["src/**/*.ts"]
}
